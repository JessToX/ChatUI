  "quiz": {
    "schemaVersion": 1,
    "contentId": "example-velocity-quiz-v1",
    "type": "quiz",
    "title": "两道小练习",
    "data": {
      "questions": [
        {
          "id": "top-point",
          "prompt": "忽略空气阻力，上抛小球到最高点时，速度和加速度怎样？",
          "options": [
            {
              "id": "a",
              "label": "速度为零，加速度向下"
            },
            {
              "id": "b",
              "label": "速度和加速度都为零"
            },
            {
              "id": "c",
              "label": "速度向上，加速度为零"
            }
          ],
          "correct": "a",
          "explanation": "最高点的瞬时速度为零，重力仍使速度沿向下方向变化。"
        },
        {
          "id": "signed-area",
          "prompt": "速度—时间图的有符号面积对应哪个量？",
          "options": [
            {
              "id": "a",
              "label": "总路程"
            },
            {
              "id": "b",
              "label": "位移"
            },
            {
              "id": "c",
              "label": "加速度"
            }
          ],
          "correct": "b",
          "explanation": "将速度对时间积分得到位移；路程需要对速度的绝对值积分。"
        }
      ],
      "followUpLabel": "按本次结果继续",
      "followUp": "请根据这次实际测验结果，针对答错的概念继续简短讲解；全对时给一道迁移练习。"
    }
  },
