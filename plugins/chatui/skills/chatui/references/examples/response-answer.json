  "blocks": [
    {
      "id": "intro",
      "kind": "prose",
      "text": "教学示例：圆柱**侧面积** $S=2\\pi rh$。当前半径 {{r}}、高度 {{h}}，两者的增长率均为 {{rate}}。不把侧面积混同于包含底面的总表面积。"
    },
    {
      "id": "substitution",
      "kind": "math",
      "tex": "\\frac{dS}{dt}=2\\pi\\left(h\\frac{dr}{dt}+r\\frac{dh}{dt}\\right)=2\\pi({{h|value}}\\times{{rate|value}}+{{r|value}}\\times{{rate|value}})",
      "label": "乘积法则"
    },
    {
      "id": "answer",
      "kind": "component",
      "type": "answer",
      "data": {
        "label": "最终答案 · 正值",
        "title": "侧面积正在增加",
        "tex": "\\frac{dS}{dt}={{coefficient|value}}\\pi\\;\\mathrm{mm}^2/\\mathrm{s}",
        "detail": "正号表示增加，mm²/s 表示每秒增加的面积。"
      }
    },
    {
      "id": "check",
      "kind": "prose",
      "text": "这一步既检查数值，也检查量纲。变化率与当前面积不是同一个量。"
    }
  ]
}
