  "title": "让结论带上单位与含义",
  "facts": {
    "r": {
      "value": 7,
      "unit": "mm"
    },
    "h": {
      "value": 7,
      "unit": "mm"
    },
    "rate": {
      "value": 1,
      "unit": "mm/s"
    },
    "coefficient": {
      "value": 28
    }
