            "id": "q1",
            "prompt": "忽略空气阻力，上抛物体到最高点时，哪项正确？",
            "options": [
              {
                "id": "a",
                "label": "速度为零，加速度向下"
              },
              {
                "id": "b",
                "label": "速度和加速度都为零"
              },
              {
                "id": "c",
                "label": "速度向上，加速度为零"
              }
            ],
            "correct": "a",
            "explanation": "最高点的瞬时速度为零，但重力仍使速度向下变化。"
          },
          {
            "id": "q2",
            "prompt": "速度—时间图的有符号面积表示什么？",
            "options": [
              {
                "id": "a",
                "label": "加速度"
              },
              {
                "id": "b",
                "label": "位移"
              },
              {
                "id": "c",
                "label": "路程"
              }
            ],
            "correct": "b",
            "explanation": "速度对时间的积分为位移；路程需要积分速度的绝对值。"
          },
          {
            "id": "q3",
            "prompt": "v(t)=20−10t（SI单位），加速度为多少？",
            "options": [
              {
                "id": "a",
                "label": "20 m/s²"
              },
              {
                "id": "b",
                "label": "10 m/s²"
              },
              {
                "id": "c",
                "label": "−10 m/s²"
              }
            ],
            "correct": "c",
            "explanation": "加速度为速度对时间的导数，因此是 −10 m/s²。"
          },
          {
            "id": "q4",
            "prompt": "m>0，合力不为零时，把力分解到两条轴上，会增加真实力的数量吗？",
            "options": [
              {
                "id": "a",
                "label": "会，每个分量都是新增的力"
              },
              {
                "id": "b",
                "label": "不会，只是同一个力的表示"
              }
            ],
            "correct": "b",
            "explanation": "分力是数学表示，不能再作为额外的真实力重复求和。"
          },
