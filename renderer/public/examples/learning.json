                {
                  "tag": "mo",
                  "text": "="
                },
                {
                  "tag": "mn",
                  "text": {
                    "fact": "topTime",
                    "format": "text"
                  }
                },
                {
                  "tag": "mtext",
                  "text": " s"
                }
              ]
            },
            "mathLabel": "最高点时间等于初速度除以重力加速度",
            "detail": "到达最高点的时间为 {{topTime}}。"
          },
          {
            "title": "再检查加速度，而不是猜测",
            "math": {
              "tag": "mrow",
              "children": [
                {
                  "tag": "mi",
                  "text": "a"
                },
                {
                  "tag": "mo",
                  "text": "="
                },
                {
                  "tag": "mo",
