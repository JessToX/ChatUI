i","text":"t"}]},"mathLabel":"\\frac{dv}{v^2}=-\\frac{k}{m}\\,dt"},{"title":"使用初始条件","detail":"采用 v(0)=v₀，避免丢掉积分常数。","math":{"tag":"mrow","children":[{"tag":"mo","text":"−"},{"tag":"mfrac","children":[{"tag":"mn","text":"1"},{"tag":"mi","text":"v"}]},{"tag":"mo","text":"+"},{"tag":"mfrac","children":[{"tag":"mn","text":"1"},{"tag":"msub","children":[{"tag":"mi","text":"v"},{"tag":"mn","text":"0"}]}]},{"tag":"mo","text":"="},{"tag":"mo","text":"−"},{"tag":"mfrac","children":[{"tag":"mi","text":"k"},{"tag":"mi","text":"m"}]},{"tag":"mi","text":"t"}]},"mathLabel":"-\\frac{1}{v}+\\frac{1}{v_0}=-\\frac{k}{m}t"},{"title":"整理速度表达式","detail":"t≥0 时分母为正，速度逐渐下降但保持正值。","math":{"tag":"mrow","children":[{"tag":"mi","text":"v"},{"tag":"mo","attrs":{"stretchy":"false"},"text":"("},{"tag":"mi","text":"t"},{"tag":"mo","attrs":{"stretchy":"false"},"text":")"},{"tag":"mo","text":"="},{"tag":"mfrac","children":[{"tag":"msub","children":[{"tag":"mi","text":"v"},{"tag":"mn","text":"0"}]},{"tag":"mrow","children":[{"tag":"mn","text":"1"},{"tag":"mo","text":"+"},{"tag":"mfrac","children":[{"tag":"mrow","children":[{"tag":"mi","text":"k"},{"tag":"msub","children":[{"tag":"mi","text":"v"},{"tag":"mn","text":"0"}]}]},{"tag":"mi","text":"m"}]},{"tag":"mi","text":"t"}]}]}]},"mathLabel":"v(t)=\\frac{v_0}{1+\\frac{k v_0}{m}t}"}]}},{"id":"check","kind":"collapse","summary":"展开：初值与量纲检查","blocks":[{"id":"check-content","kind":"prose","nodes":[{"type":"paragraph","children":[{"type":"text","text":"代入 "},{"type":"math","tex":"t=0","display":false,"math":{"tag":"mrow","children":[{"tag":"mi","text":"t"},{"tag":"mo","text":"="},{"tag":"mn","text":"0"}]}},{"type":"text","text":" 得 "},{"type":"math","tex":"v(0)=v_0","display":false,"math":{"tag":"mrow","children":[{"tag":"mi","text":"v"},{"tag":"mo","attrs":{"stretchy":"false"},"text":"("},{"tag":"mn","text":"0"},{"tag":"mo","attrs":{"stretchy":"false"},"text":")"},{"tag":"mo","text":"="},{"tag":"msub","children":[{"tag":"mi","text":"v"},{"tag":"mn","text":"0"}]}]}},{"type":"text","text":"。又因 "},{"type":"math","tex":"[k]=\\mathrm{kg}/\\mathrm{m}","display":false,"math":{"tag":"mrow","children":[{"tag":"mo","attrs":{"stretchy":"false"},"text":"["},{"tag":"mi","text":"k"},{"tag":"mo","attrs":{"stretchy":"false"},"text":"]"},{"tag":"mo","text":"="},{"tag":"mrow","children":[{"tag":"mi","attrs":{"mathvariant":"normal"},"text":"k"},{"tag":"mi","attrs":{"mathvariant":"normal"},"text":"g"}]},{"tag":"mi","attrs":{"mathvariant":"normal"},"text":"/"},{"tag":"mi","attrs":{"mathvariant":"normal"},"text":"m"}]}},{"type":"text","text":"，所以 "},{"type":"math","tex":"kv_0t/m","display":false,"math":{"tag":"mrow","children":[{"tag":"mi","text":"k"},{"tag":"msub","children":[{"tag":"mi","text":"v"},{"tag":"mn","text":"0"}]},{"tag":"mi","text":"t"},{"tag":"mi","attrs":{"mathvariant":"normal"},"text":"/"},{"tag":"mi","text":"m"}]}},{"type":"text","text":" 无量纲，可以与 1 相加。"}]}]}]}],"viewVersion":1},"content":[{"type":"text","text":"# 从受力到速度关系\n\n设质量 \\(m>0\\)、阻力系数 \\(k>0\\) 为常数，初速度 \\(v_0>0\\)。下面只讨论 \\(t\\ge0\\) 时的正向运动。\n\n\n\n1. 建立运动方程\nm\\frac{dv}{dt}=-kv^2\nm(dv)/(dt)=−kv^(2)\n负号表示阻力与速度方向相反。\n2. 分离变量\n\\frac{dv}{v^2}=-\\frac{k}{m}\\,dt\n(dv)/(v^(2))=−(k)/(m) dt\n在 v>0 的范围内进行除法，两边分别积分。\n3. 使用初始条件\n-\\frac{1}{v}+\\frac{1}{v_0}=-\\frac{k}{m}t\n−(1)/(v)+(1)/(v_(0))=−(k)/(m)t\n采用 v(0)=v₀，避免丢掉积分常数。\n4. 整理速度表达式\nv(t)=\\frac{v_0}{1+\\frac{k v_0}{m}t}\nv(t)=(v_(0))/(1+(kv_(0))/(m)t)\nt≥0 时分母为正，速度逐渐下降但保持正值。\n\n展开：初值与量纲检查\n代入 \\(t=0\\) 得 \\(v(0)=v_0\\)。又因 \\([k]=\\mathrm{kg}/\\mathrm{m}\\)，所以 \\(kv_0t/m\\) 无量纲，可以与 1 相加。"}]}