rmal"},"text":"c"},{"tag":"mi","attrs":{"mathvariant":"normal"},"text":"m"}]}]}},{"type":"math","tex":"A_{\\max}=\\frac{3\\sqrt{3}}{4}r^2","display":true,"math":{"tag":"mrow","children":[{"tag":"msub","children":[{"tag":"mi","text":"A"},{"tag":"mi","text":"max"},{"tag":"mo","text":"⁡"}]},{"tag":"mo","text":"="},{"tag":"mfrac","children":[{"tag":"mrow","children":[{"tag":"mn","text":"3"},{"tag":"msqrt","children":[{"tag":"mn","text":"3"}]}]},{"tag":"mn","text":"4"}]},{"tag":"msup","children":[{"tag":"mi","text":"r"},{"tag":"mn","text":"2"}]}]}},{"type":"math","tex":"A_{\\max}=3\\sqrt{3}\\,\\mathrm{cm}^2","display":true,"math":{"tag":"mrow","children":[{"tag":"msub","children":[{"tag":"mi","text":"A"},{"tag":"mi","text":"max"},{"tag":"mo","text":"⁡"}]},{"tag":"mo","text":"="},{"tag":"mn","text":"3"},{"tag":"msqrt","children":[{"tag":"mn","text":"3"}]},{"tag":"mtext","text":" "},{"tag":"msup","children":[{"tag":"mrow","children":[{"tag":"mi","attrs":{"mathvariant":"normal"},"text":"c"},{"tag":"mi","attrs":{"mathvariant":"normal"},"text":"m"}]},{"tag":"mn","text":"2"}]}]}},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","text":"固定结论：h=3 cm，底边 b=2√3 cm，最大面积 A=3√3 cm²≈5.1961524227 cm²。"}]},{"type":"text","text":" 这组结论属于 r=2 cm 的题设，不随下方滑块改写。"}]},{"type":"paragraph","children":[{"type":"text","text":"还有一条独立核对路径：最大值处三角形为等边三角形，外接圆半径 r 对应边长 √3r。用等边三角形面积公式，而非重复代入前面的面积函数："}]},{"type":"math","tex":"A=\\frac{\\sqrt{3}}{4}(\\sqrt{3}r)^2=\\frac{3\\sqrt{3}}{4}r^2=3\\sqrt{3}\\,\\mathrm{cm}^2","display":true,"math":{"tag":"mrow","children":[{"tag":"mi","text":"A"},{"tag":"mo","text":"="},{"tag":"mfrac","children":[{"tag":"msqrt","children":[{"tag":"mn","text":"3"}]},{"tag":"mn","text":"4"}]},{"tag":"mo","attrs":{"stretchy":"false"},"text":"("},{"tag":"msqrt","children":[{"tag":"mn","text":"3"}]},{"tag":"mi","text":"r"},{"tag":"msup","children":[{"tag":"mo","attrs":{"stretchy":"false"},"text":")"},{"tag":"mn","text":"2"}]},{"tag":"mo","text":"="},{"tag":"mfrac","children":[{"tag":"mrow","children":[{"tag":"mn","text":"3"},{"tag":"msqrt","children":[{"tag":"mn","text":"3"}]}]},{"tag":"mn","text":"4"}]},{"tag":"msup","children":[{"tag":"mi","text":"r"},{"tag":"mn","text":"2"}]},{"tag":"mo","text":"="},{"tag":"mn","text":"3"},{"tag":"msqrt","children":[{"tag":"mn","text":"3"}]},{"tag":"mtext","text":" "},{"tag":"msup","children":[{"tag":"mrow","children":[{"tag":"mi","attrs":{"mathvariant":"normal"},"text":"c"},{"tag":"mi","attrs":{"mathvariant":"normal"},"text":"m"}]},{"tag":"mn","text":"2"}]}]}},{"type":"heading","level":2,"children":[{"type":"text","text":"03 · 当前实验：从 h/r=1 开始"}]},{"type":"paragraph","children":[{"type":"text","text":"实验的初始状态故意选在 h/r=1：此时 h=2 cm、b=4 cm、A=4 cm²。拖动高度比例，观察图形、长度和面积一起变化。上方的最优结论保持固定，下方的读数描述你当前选择的三角形。"}]}]},{"id":"d_aab71b428d2c8924_0","kind":"component","type":"geometry","data":{"radius":2,"heightRatio":1,"unit":"cm"}},{"id":"d_026fa93698ba6030_0","kind":"prose","nodes":[{"type":"paragraph","children":[{"type":"text","text":"先找到 h/r=1.5，再移动到另一个高度。比较当前面积与 3√3 cm²，并解释：为什么底边变长，并不保证面积继续增加？重置预览会回到初始 h/r=1；重新载入时可能恢复本地已保存的真实操作。"}]},{"type":"heading","level":2,"children":[{"type":"text","text":"04 · 边界与自检"}]},{"type":"paragraph","children":[{"type":"text","text":"解析端点 h=0 和 h=2r 都是退化三角形，面积为零。现有滑块只覆盖 0.05≤h/r≤1.95，两个端点不在实验范围内；不要把滑块最左或最右的位置当成退化端点。"}]},{"type":"paragraph","children":[{"type":"text","text":"长度以 cm 计，面积以 cm² 计。固定半径不变时，改变高度会同时改变底边。当前图形与最优图形不同，表示你正在比较不同状态，并不推翻极值推导。"}]}]}],"viewVersion":1,"mode":"document","documentVersion":1,"sourceHash":"f9e9c88620ed781a","callouts":{}},"content":[{"type":"text","text":"# 圆内的三角形，什么时候面积最大？\n\n半径固定，三角形越高，底边却未必越宽。先从几何关系找到面积的最大值，再用下面的实验检查自己的直觉。\n\n\n## 01 · 题设与变量\n取半径 r=2 cm 的圆，顶点 A 固定在圆的最上方，底边 BC 平行于水平直径，三个顶点都在圆上。三角形的高记为 h，底边长为 b。这里只讨论非退化三角形，定义域是 \\(0<h<2r\\)。圆心到底边的有向距离为 r−h；它可以为负，长度关系仍由平方给出。\n\n\n\\[x=\\frac b2=\\sqrt{r^2-(r-h)^2}=\\sqrt{2rh-h^2}\\]\n这里 x 是半底边，不是整个底边。面积中的二分之一与底边的系数二相消，因此 A(h)=h√(2rh−h²)，而不是再乘一个二。\n\n\n## 02 · 固定推导：寻找最优高度\n在定义域内根号为正，求导得到：\n\n\n\\[A'(h)=\\frac{h(3r-2h)}{\\sqrt{2rh-h^2}}\\]\n由于 h>0，导数的符号由 3r−2h 决定。高度小于 3r/2 时面积递增，大于 3r/2 时面积递减；两端的极限面积都是零，所以唯一最大值出现在 h/r=1.5。\n\n\n\\[h=\\frac{3r}{2}=3\\,\\mathrm{cm}\\]\n\n\\[b=\\sqrt{3}r=2\\sqrt{3}\\,\\mathrm{cm}\\]\n\n\\[A_{\\max}=\\frac{3\\sqrt{3}}{4}r^2\\]\n\n\\[A_{\\max}=3\\sqrt{3}\\,\\mathrm{cm}^2\\]\n**固定结论：h=3 cm，底边 b=2√3 cm，最大面积 A=3√3 cm²≈5.1961524227 cm²。** 这组结论属于 r=2 cm 的题设，不随下方滑块改写。\n\n还有一条独立核对路径：最大值处三角形为等边三角形，外接圆半径 r 对应边长 √3r。用等边三角形面积公式，而非重复代入前面的面积函数：\n\n\n\\[A=\\frac{\\sqrt{3}}{4}(\\sqrt{3}r)^2=\\frac{3\\sqrt{3}}{4}r^2=3\\sqrt{3}\\,\\mathrm{cm}^2\\]\n\n## 03 · 当前实验：从 h/r=1 开始\n实验的初始状态故意选在 h/r=1：此时 h=2 cm、b=4 cm、A=4 cm²。拖动高度比例，观察图形、长度和面积一起变化。上方的最优结论保持固定，下方的读数描述你当前选择的三角形。\n\n\n\n圆内接三角形实验：半径 r=2 cm，初始高度 h/r=1。\n底边 b=2√(2rh−h²)，面积 A=h√(2rh−h²)。\n初始实验结果：高度 2 cm；半底边 2 cm；底边 4 cm；面积 4 cm²。\n滑块或精确输入范围 0.05≤h/r≤1.95；结果表随当前实验联动，重置恢复初始值。固定推导与全文复制保留初始题设。\n\n先找到 h/r=1.5，再移动到另一个高度。比较当前面积与 3√3 cm²，并解释：为什么底边变长，并不保证面积继续增加？重置预览会回到初始 h/r=1；重新载入时可能恢复本地已保存的真实操作。\n\n\n## 04 · 边界与自检\n解析端点 h=0 和 h=2r 都是退化三角形，面积为零。现有滑块只覆盖 0.05≤h/r≤1.95，两个端点不在实验范围内；不要把滑块最左或最右的位置当成退化端点。\n\n长度以 cm 计，面积以 cm² 计。固定半径不变时，改变高度会同时改变底边。当前图形与最优图形不同，表示你正在比较不同状态，并不推翻极值推导。"}]}